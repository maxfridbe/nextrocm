#include "vae.hpp"
extern "C" int nrqi_vae_conv(void*g,const void*x,int64_t h,int64_t w,int64_t ci,const void*wt,int64_t co,int k,int s,const float*b,void*out){return nrqi_vae::conv_launch(g,x,h,w,ci,wt,co,k,s,b,out);}
extern "C" int nrqi_vae_up2(void*g,const void*x,int64_t h,int64_t w,int64_t c,void*out){return nrqi_vae::spatial_launch(g,x,h,w,c,c,1,out,0);}
extern "C" int nrqi_vae_dupup_add(void*g,const void*x,int64_t h,int64_t w,int64_t ci,int64_t co,int ft,void*out){return nrqi_vae::spatial_launch(g,x,h,w,ci,co,ft,out,1);}
extern "C" int nrqi_vae_pad_br(void*g,const void*x,int64_t h,int64_t w,int64_t c,void*out){return nrqi_vae::spatial_launch(g,x,h,w,c,c,1,out,2);}
extern "C" int nrqi_vae_avg_down_add(void*g,const void*x,int64_t h,int64_t w,int64_t ci,int64_t co,int ft,void*out){return nrqi_vae::spatial_launch(g,x,h,w,ci,co,ft,out,3);}
extern "C" int nrqi_vae_silu(void*ctx,void*x,int64_t n){nrqi_vae::Span s;if(!ctx||n>INT32_MAX||!nrqi_vae::span(x,n,2,s))return ns_fail("VAE silu: invalid span");auto*g=static_cast<ns_gpu*>(ctx);NS_CU(hipSetDevice(g->dev));nrqi_vae::silu<<<dim3(unsigned((n+255)/256)),256,0,g->q>>>(static_cast<__half*>(x),n);NS_LAUNCH_CHECK();return 0;}
extern "C" int nrqi_vae_softmax(void*ctx,const float*x,int64_t m,int64_t n,float scale,void*out){if(!ctx||m<1||m>65536||n<1||n>65536||m*n>INT32_MAX||!std::isfinite(scale)||scale<=0||!nrqi_vae::pair(x,m*n,out,m*n,4,2))return ns_fail("VAE softmax: invalid spans");auto*g=static_cast<ns_gpu*>(ctx);NS_CU(hipSetDevice(g->dev));nrqi_vae::softmax<<<dim3(unsigned(m)),256,0,g->q>>>(x,n,scale,static_cast<__half*>(out));NS_LAUNCH_CHECK();return 0;}
extern "C" int nrqi_vae_rgba8(void*ctx,const void*x,int64_t h,int64_t w,uint8_t*out){if(!ctx||!nrqi_vae::image(h,w,4)||!nrqi_vae::pair(x,h*w*4,out,h*w*4,2,1))return ns_fail("VAE rgba: invalid spans");auto*g=static_cast<ns_gpu*>(ctx);NS_CU(hipSetDevice(g->dev));nrqi_vae::rgba<<<dim3(unsigned((h*w*4+255)/256)),256,0,g->q>>>(static_cast<const __half*>(x),h*w*4,out);NS_LAUNCH_CHECK();return 0;}
